{
  "name": "iptv-player",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~58.0.12",
    "expo-build-properties": "~58.0.10",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.8",
    "expo-image": "~58.0.15",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.21",
    "expo-splash-screen": "~58.0.9",
    "expo-status-bar": "~58.0.3",
    "expo-video": "~58.0.11",
    "hls.js": "^1.7.3",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "data:build": "tsx scripts/build-data.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "serve:web": "node server/server.mjs",
    "proxy": "PROXY_ONLY=1 PORT=8787 node server/server.mjs",
    "web:dev": "EXPO_PUBLIC_PROXY_URL=http://localhost:8787 expo start --web",
    "android:apk": "node scripts/build-apk.mjs"
  },
  "private": true
